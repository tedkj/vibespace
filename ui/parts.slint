// VibeSpace's own small parts and icons (the shared design system stays untouched in vibeware/).

import { Theme, Type, Chamfer } from "@vibeware";

// On the VibeWare icon grid (16 units, 1-unit strokes, 0/45/90 degrees, see vibeware/icons.slint).
export global AppIcons {
    // A cloud of chamfers: online only.
    out property <string> cloud: "M 4.5 12.5 L 2.5 10.5 L 2.5 9.5 L 4.5 7.5 L 5.5 7.5 L 7.5 5.5 L 9.5 5.5 L 11.5 7.5 L 12.5 7.5 L 14.5 9.5 L 14.5 10.5 L 12.5 12.5 Z";
    // The map: a tile split as a treemap splits it.
    out property <string> map: "M 2.5 2.5 L 14.5 2.5 L 14.5 14.5 L 2.5 14.5 Z M 9.5 2.5 L 9.5 14.5 M 2.5 9.5 L 9.5 9.5 M 9.5 7.5 L 14.5 7.5";
    // Scan: a drive with a sweep line over it.
    out property <string> scan: "M 1.5 8.5 L 4.5 5.5 L 12.5 5.5 L 15.5 8.5 L 15.5 12.5 L 1.5 12.5 Z M 1.5 8.5 L 15.5 8.5 M 12 10.5 L 14 10.5 M 4.5 2.5 L 12.5 2.5";
}

// Mono column head.
export component Head inherits Text {
    font-family: Type.mono;
    font-size: Type.small;
    color: Theme.ink-3;
    vertical-alignment: center;
    accessible-role: none;
    overflow: elide;
}

// A share of the parent: a hairline track with a filled part, on the pixel grid.
export component ShareBar inherits Rectangle {
    in property <float> share;
    in property <color> fill: Theme.ink-3;
    height: 6px;
    accessible-role: none;
    background: Theme.surface-3;
    Rectangle {
        x: 0;
        width: Math.round(parent.width / 1px * Math.clamp(root.share, 0, 1)) * 1px;
        background: root.fill;
    }
}

// A fact of the summary strip: the mono label above, the measured value below.
export component Fact inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: true;
    in property <bool> strong;
    in property <bool> warn;
    min-width: Math.max(l.preferred-width, v.min-width) + 20px;
    preferred-width: Math.max(l.preferred-width, v.preferred-width) + 20px;
    height: 44px;
    accessible-role: text;
    accessible-label: root.label + " " + root.value;
    Chamfer {
        width: 100%;
        height: 100%;
        fill: Theme.surface;
        stroke: Theme.line;
    }
    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 5px;
        padding-bottom: 5px;
        l := Text {
            text: root.label;
            font-family: Type.mono;
            font-size: Type.small;
            color: Theme.ink-3;
            accessible-role: none;
        }
        v := Text {
            text: root.value;
            font-family: root.mono ? Type.mono : Type.ui;
            font-size: Type.body;
            font-weight: root.strong ? Type.strong : Type.regular;
            color: root.warn ? Theme.warn-text : Theme.ink;
            overflow: elide;
            accessible-role: none;
        }
    }
}

// A small square of a map colour.
export component Swatch inherits Rectangle {
    in property <color> colour;
    width: 10px;
    height: 10px;
    accessible-role: none;
    background: root.colour;
}
